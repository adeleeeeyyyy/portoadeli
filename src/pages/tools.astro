---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Adly Fahreza - Personal Web — Tools">

  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- TOOLS HEADER -->
    <div class="bb-static mb-8 overflow-hidden fi d1 bg-[#111111] text-white pt-10 pb-6 px-6 sm:p-8 md:p-12 relative">
      <div class="absolute top-4 left-4 border border-white/20 text-white/40 text-[9px] font-mono tracking-widest uppercase">
        WORKSPACE TOOLS // VERSION 2.0
      </div>
      <h1 class="text-[36px] sm:text-[48px] md:text-[64px] mt-4" style="font-family:'Bebas Neue', sans-serif; line-height: 0.9; text-transform: uppercase; font-weight: 500; letter-spacing: -0.01em;">
        WORKSPACE UTILITIES
      </h1>
      <p style="font-size:.85rem;margin-top:.5rem;color:#cacacb;max-width:560px;font-weight:500;line-height:1.6;">
        A high-fidelity collection of engineering utilities designed for System Administration, Graphic Design, and Backend Development.
      </p>
    </div>

    <!-- TABS -->
    <div class="fi d2">
      <div class="flex gap-1.5 flex-wrap justify-center lg:justify-start mb-6">
        <button class="tab-btn active" onclick="switchToolsTab('sysadmin')">SYSADMIN</button>
        <button class="tab-btn" onclick="switchToolsTab('graphic')">GRAPHIC DESIGN</button>
        <button class="tab-btn" onclick="switchToolsTab('backend')">BACKEND</button>
      </div>

      <!-- SYSADMIN TAB: RAID VISUALIZER -->
      <div id="tab-sysadmin" class="tab-content active">
        <div class="bb p-6 md:p-8 bg-white text-[#111111]">
          <div class="section-title text-2xl mb-4 font-bold tracking-tight">✦ RAID HDD VISUALIZER</div>
          <div class="flex flex-col md:flex-row gap-8">

            <!-- Controls -->
            <div class="flex-1" style="min-width: 250px;">
              <div class="mb-4">
                <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#707072;">RAID Level</label>
                <select id="raid-level" class="tag w-full"
                  style="margin-top:4px; font-size:.8rem; padding:10px 14px; border:1px solid var(--hairline); background:var(--soft-cloud); border-radius:30px; font-weight:700;"
                  onchange="updateRaid()">
                  <option value="0">RAID 0 (Striping)</option>
                  <option value="1">RAID 1 (Mirroring)</option>
                  <option value="5" selected>RAID 5 (Parity)</option>
                  <option value="6">RAID 6 (Double Parity)</option>
                  <option value="10">RAID 10 (Stripe of Mirrors)</option>
                </select>
              </div>

              <div class="mb-4">
                <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#707072;">Number of Drives</label>
                <input type="number" id="drive-count" value="4" min="2" max="24" class="tag w-full"
                  style="margin-top:4px; font-size:.8rem; padding:10px 14px; border:1px solid var(--hairline); background:var(--soft-cloud); border-radius:30px; font-weight:700;"
                  onchange="updateRaid()" />
              </div>

              <div class="mb-4">
                <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#707072;">Size per Drive (TB)</label>
                <input type="number" id="drive-size" value="2" min="1" max="22" class="tag w-full"
                  style="margin-top:4px; font-size:.8rem; padding:10px 14px; border:1px solid var(--hairline); background:var(--soft-cloud); border-radius:30px; font-weight:700;"
                  onchange="updateRaid()" />
              </div>

              <div class="p-4 bg-[#f5f5f5] border border-[#cacacb] mb-4">
                <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:0.75rem; font-weight:600;">
                  <span style="color:#707072; text-transform:uppercase;">Raw Capacity:</span>
                  <span id="raw-cap" style="color:#111111;">8 TB</span>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:0.75rem; font-weight:600;">
                  <span style="color:#707072; text-transform:uppercase;">Usable Capacity:</span>
                  <span id="usable-cap" style="color:#111111;">6 TB</span>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:0.75rem; font-weight:600;">
                  <span style="color:#707072; text-transform:uppercase;">Fault Tolerance:</span>
                  <span id="fault-tol" style="color:#111111;">1 Drive</span>
                </div>
              </div>
              <p id="raid-desc" style="font-size:0.72rem; color:#707072; margin-top:1rem; line-height:1.6; font-weight:500;">RAID 5 requires
                at least 3 drives. It stripes data and parity across all drives, allowing for 1 drive failure without
                data loss.</p>

              <div class="bb p-4 mt-4"
                style="background:#111111; color:#ffffff; font-family:monospace; font-size:0.7rem; overflow-x:auto; border-radius:0px;">
                <div style="color:#cacacb; margin-bottom:4px; font-weight:700;"># mdadm configuration</div>
                <div id="raid-command" style="white-space:nowrap; color:#ffffff;"></div>
              </div>
            </div>

            <!-- Visualization -->
            <div class="flex-2" style="flex:2;">
              <div id="raid-visual" class="grid gap-3"
                style="grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));">
                <!-- Drives generated by JS -->
              </div>

              <div class="mt-6 flex gap-4 text-[10px] font-bold text-[#707072] uppercase tracking-wider justify-center flex-wrap">
                <div class="flex items-center gap-2">
                  <div style="width:12px;height:12px;background:#3b82f6;border:1px solid var(--ink);"></div> Data
                </div>
                <div class="flex items-center gap-2">
                  <div style="width:12px;height:12px;background:#f59e0b;border:1px solid var(--ink);"></div> Parity
                </div>
                <div class="flex items-center gap-2">
                  <div style="width:12px;height:12px;background:#10b981;border:1px solid var(--ink);"></div> Mirror
                </div>
                <div class="flex items-center gap-2">
                  <div style="width:12px;height:12px;background:#ef4444;border:1px solid var(--ink);"></div> Unused
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- GRAPHIC DESIGN TAB -->
      <div id="tab-graphic" class="tab-content" style="display:none;">
        <div class="bb p-6 md:p-8 bg-white text-[#111111]">
          <div class="section-title text-2xl mb-4 font-bold tracking-tight">✦ COLOR PALETTE GENERATOR</div>

          <div class="flex flex-col lg:flex-row gap-8">
            <!-- Left: Controls -->
            <div class="flex-1" style="min-width:250px;">
              <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:1rem; gap:12px;">
                <p style="font-size:0.75rem; color:#707072; margin:0; font-weight:500; line-height:1.6;">Pick colors to generate a coherent design system theme. The live preview updates instantly.</p>
                <button id="btn-random" onclick="randomPalette()" class="btn-random">🎲 RANDOMIZE</button>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-4">
                <div>
                  <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; color:#707072;">Primary</label>
                  <input type="color" id="cp-primary" value="#3b82f6"
                    class="w-full h-10 border border-[#cacacb] cursor-pointer" oninput="updatePalette()">
                </div>
                <div>
                  <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; color:#707072;">Secondary</label>
                  <input type="color" id="cp-secondary" value="#8b5cf6"
                    class="w-full h-10 border border-[#cacacb] cursor-pointer" oninput="updatePalette()">
                </div>
                <div>
                  <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; color:#707072;">Accent</label>
                  <input type="color" id="cp-accent" value="#f59e0b"
                    class="w-full h-10 border border-[#cacacb] cursor-pointer" oninput="updatePalette()">
                </div>
                <div>
                  <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; color:#707072;">Background</label>
                  <input type="color" id="cp-bg" value="#f8fafc"
                    class="w-full h-10 border border-[#cacacb] cursor-pointer" oninput="updatePalette()">
                </div>
                <div class="col-span-2">
                  <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; color:#707072;">Text / Ink</label>
                  <input type="color" id="cp-text" value="#0f172a"
                    class="w-full h-10 border border-[#cacacb] cursor-pointer" oninput="updatePalette()">
                </div>
              </div>

              <!-- Tailwind Config Snippet -->
              <div class="bb-sm p-4"
                style="background:#111111; color:#ffffff; font-family:monospace; font-size:0.68rem; overflow-x:auto; border-radius:0px;">
                <div style="color:#cacacb; margin-bottom:6px; font-weight:700;">// tailwind.config.js</div>
                <pre id="tw-config" style="margin:0;"></pre>
              </div>
            </div>

            <!-- Right: Live Preview -->
            <div class="flex-2 p-0 overflow-hidden bg-[#f5f5f5] border border-[#cacacb]"
              style="flex:2; border-radius:0px; position:relative;">
              <div
                style="background:#ffffff; color:#111111; font-size:0.6rem; padding:8px 16px; font-weight:700; border-bottom: 1px solid var(--hairline); text-transform:uppercase; letter-spacing:0.08em;">
                Live Preview</div>

              <!-- Mock Website Container -->
              <div id="mock-site"
                style="--m-primary:#3b82f6; --m-secondary:#8b5cf6; --m-accent:#f59e0b; --m-bg:#f8fafc; --m-text:#0f172a; background:var(--m-bg); color:var(--m-text); min-height: 350px; font-family:'Inter', sans-serif; transition: background 0.3s, color 0.3s;">

                <!-- Mock Nav -->
                <div style="padding:1.5rem; display:flex; justify-content:space-between; align-items:center;">
                  <div style="font-weight:800; font-size:1.1rem; letter-spacing:-0.02em;">Brand.</div>
                  <div style="display:flex; gap:1.5rem; font-size:0.8rem; font-weight:500; opacity:0.8;">
                    <span>Home</span><span>About</span><span>Contact</span>
                  </div>
                </div>

                <!-- Mock Hero -->
                <div style="padding:3rem 1.5rem; text-align:center;">
                  <h1
                    style="font-size:2.2rem; font-weight:800; line-height:1.15; margin-bottom:1rem; letter-spacing:-0.02em;">
                    Build Faster with Tailored Colors</h1>
                  <p style="font-size:0.95rem; max-width:70%; margin:0 auto 2rem auto; opacity:0.6; line-height:1.6;">
                    Visualize your design language instantly before writing a single line of CSS. Minimalist, clean, and
                    modern.</p>
                  <button
                    style="background:var(--m-primary); color:var(--m-bg); border:none; padding:0.75rem 1.75rem; font-weight:600; font-size:0.9rem; border-radius:99px; cursor:pointer; box-shadow: 0 4px 14px 0 var(--m-primary); opacity:0.9; transition: background 0.3s;">Get
                    Started</button>
                  <button
                    style="background:transparent; color:var(--m-text); border:1px solid var(--m-text); opacity:0.6; padding:0.75rem 1.75rem; font-weight:600; font-size:0.9rem; border-radius:99px; cursor:pointer; margin-left:0.75rem;">Learn
                    More</button>
                </div>

                <!-- Mock Features -->
                <div
                  style="padding:2rem 1.5rem; display:flex; gap:1.5rem; flex-wrap:wrap; justify-content:center; background:rgba(0,0,0,0.02); border-top:1px solid rgba(0,0,0,0.03);">
                  <div
                    style="flex:1; min-width:140px; background:var(--m-bg); padding:1.5rem; border-radius:12px; box-shadow: 0 8px 24px rgba(0,0,0,0.04); border:1px solid rgba(0,0,0,0.02);">
                    <div
                      style="width:36px; height:36px; background:var(--m-accent); border-radius:8px; margin-bottom:1rem; display:flex; align-items:center; justify-content:center; opacity:0.9;">
                      <div style="width:12px; height:12px; background:var(--m-bg); border-radius:50%;"></div>
                    </div>
                    <div style="font-weight:700; font-size:1rem; margin-bottom:0.5rem; color:var(--m-text);">Design
                    </div>
                    <div style="font-size:0.8rem; opacity:0.6; line-height:1.5;">Beautiful mockups instantly with soft
                      shadows and clean typography.</div>
                  </div>
                  <div
                    style="flex:1; min-width:140px; background:var(--m-bg); padding:1.5rem; border-radius:12px; box-shadow: 0 8px 24px rgba(0,0,0,0.04); border:1px solid rgba(0,0,0,0.02);">
                    <div
                      style="width:36px; height:36px; background:var(--m-secondary); border-radius:8px; margin-bottom:1rem; display:flex; align-items:center; justify-content:center; opacity:0.9;">
                      <div style="width:12px; height:12px; border:2px solid var(--m-bg); border-radius:3px;"></div>
                    </div>
                    <div style="font-weight:700; font-size:1rem; margin-bottom:0.5rem; color:var(--m-text);">Develop
                    </div>
                    <div style="font-size:0.8rem; opacity:0.6; line-height:1.5;">Export configurations fast and
                      integrate perfectly with Tailwind.</div>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- BACKEND TAB -->
      <div id="tab-backend" class="tab-content" style="display:none;">
        <div class="bb p-6 md:p-8 bg-white text-[#111111]">
          <div class="section-title text-2xl mb-4 font-bold tracking-tight">✦ API TESTER</div>
          <p style="font-size:0.75rem; color:#707072; margin-bottom:1.5rem; font-weight:500;">A lightweight, browser-based API client. Note: Subject to CORS policies.</p>

          <div class="flex flex-col gap-4">

            <!-- Request Section -->
            <div class="p-6 bg-[#f5f5f5] border border-[#cacacb]">

              <!-- URL Bar -->
              <div class="flex flex-col md:flex-row gap-3 mb-4">
                <select id="api-method"
                  style="padding:10px 16px; border:1px solid var(--hairline); font-weight:800; background:#ffffff; cursor:pointer; outline:none; font-family:monospace; border-radius:30px; font-size:0.8rem;">
                  <option value="GET">GET</option>
                  <option value="POST">POST</option>
                  <option value="PUT">PUT</option>
                  <option value="PATCH">PATCH</option>
                  <option value="DELETE">DELETE</option>
                </select>
                <input type="text" id="api-url" placeholder="https://jsonplaceholder.typicode.com/todos/1"
                  style="flex:1; padding:10px 16px; border:1px solid var(--hairline); font-family:monospace; font-size:0.8rem; outline:none; border-radius:30px;">
                <button onclick="sendApiRequest()"
                  style="background:var(--ink); color:var(--canvas); padding:10px 28px; font-weight:800; border:none; border-radius:30px; cursor:pointer; font-size:0.8rem; transition:transform 0.1s;">SEND</button>
              </div>

              <!-- Tabs & Body -->
              <div>
                <div class="flex gap-4 mb-2" style="border-bottom:1px solid var(--hairline); padding-bottom:8px;">
                  <span style="font-size:0.7rem; font-weight:800; color:var(--ink); text-transform:uppercase; letter-spacing:0.05em;">JSON Request Body</span>
                </div>
                <textarea id="api-body" placeholder="{&#10;  &#34;key&#34;: &#34;value&#34;&#10;}"
                  style="width:100%; height:120px; padding:12px; border:1px solid var(--hairline); font-family:monospace; font-size:0.75rem; resize:vertical; background:#ffffff; outline:none; border-radius:0px;"></textarea>
              </div>

            </div>

            <!-- Response Section -->
            <div class="p-0 overflow-hidden border border-[#cacacb]">
              <!-- Response Header -->
              <div
                style="background:#ffffff; padding:10px 16px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--hairline);">
                <div style="font-weight:800; font-size:0.7rem; color:#707072; text-transform:uppercase; letter-spacing:0.05em;">Response Payload</div>
                <div class="flex gap-4"
                  style="font-size:0.7rem; font-family:monospace; font-weight:700;">
                  <span style="color:#707072;">STATUS: <span id="api-status" style="color:#10b981;">---</span></span>
                  <span style="color:#707072;">TIME: <span id="api-time" style="color:var(--ink);">---</span></span>
                </div>
              </div>

              <!-- Response Body -->
              <div style="background:#111111; padding:16px; overflow-x:auto; max-height:400px; overflow-y:auto;">
                <pre id="api-response"
                  style="margin:0; font-family:monospace; font-size:0.75rem; color:#a5b4fc; white-space:pre-wrap; word-wrap:break-word;">Hit 'SEND' to see the response here...</pre>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>

  </div>

  <style>
    @keyframes popIn {
      0% {
        transform: scale(0.9);
        opacity: 0;
      }

      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    @keyframes dropData {
      0% {
        transform: translate(-50%, -30px);
        opacity: 1;
      }

      60% {
        transform: translate(-50%, 80px);
        opacity: 1;
      }

      80% {
        transform: translate(-50%, 100px);
        opacity: 0;
      }

      100% {
        transform: translate(-50%, 100px);
        opacity: 0;
      }
    }

    .btn-random {
      background: var(--ink);
      color: var(--bg);
      border: none;
      padding: 8px 16px;
      font-size: 0.75rem;
      font-weight: 800;
      border-radius: 99px;
      cursor: pointer;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-random:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.3);
      background: #334155;
    }

    .btn-random:active {
      transform: translateY(0) scale(0.95);
    }

    .btn-random .dice {
      display: inline-block;
    }

    .btn-random.spin .dice {
      animation: spinDice 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes spinDice {
      0% {
        transform: rotate(0deg) scale(1);
      }

      50% {
        transform: rotate(180deg) scale(1.4);
      }

      100% {
        transform: rotate(360deg) scale(1);
      }
    }
  </style>

  <script is:inline>
    function switchToolsTab(tabId) {
      const current = document.querySelector('.tab-content.active');
      if (current && current.id === 'tab-' + tabId) return;

      if (current) {
        current.classList.add('exit');
        current.classList.remove('active');
        setTimeout(() => {
          current.classList.remove('exit');
          current.style.display = 'none';

          const next = document.getElementById('tab-' + tabId);
          if (next) {
            next.style.display = 'block';
            next.classList.add('active');
          }
        }, 300);
      } else {
        const next = document.getElementById('tab-' + tabId);
        if (next) {
          next.style.display = 'block';
          next.classList.add('active');
        }
      }

      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      if (event && event.target) event.target.classList.add('active');
    }

    function updateRaid() {
      const level = parseInt(document.getElementById('raid-level').value);
      const countInput = document.getElementById('drive-count');
      let count = parseInt(countInput.value);
      const size = parseFloat(document.getElementById('drive-size').value);

      const visual = document.getElementById('raid-visual');
      const rawEl = document.getElementById('raw-cap');
      const usableEl = document.getElementById('usable-cap');
      const faultEl = document.getElementById('fault-tol');
      const descEl = document.getElementById('raid-desc');

      // Constraints
      let minDrives = 2;
      let evenRequired = false;

      if (level === 0) { minDrives = 2; descEl.textContent = "RAID 0 (Striping): High performance, but NO fault tolerance. If one drive fails, all data is lost."; }
      else if (level === 1) { minDrives = 2; countInput.value = 2; count = 2; descEl.textContent = "RAID 1 (Mirroring): Data is duplicated. High read performance and fault tolerance of 1 drive."; }
      else if (level === 5) { minDrives = 3; descEl.textContent = "RAID 5 (Parity): Requires at least 3 drives. Good balance of performance and space. 1 drive fault tolerance."; }
      else if (level === 6) { minDrives = 4; descEl.textContent = "RAID 6 (Double Parity): Requires at least 4 drives. 2 drive fault tolerance."; }
      else if (level === 10) { minDrives = 4; evenRequired = true; descEl.textContent = "RAID 10: Requires at least 4 drives (even number). Combines striping and mirroring for high performance and fault tolerance."; }

      if (count < minDrives) { count = minDrives; countInput.value = count; }
      if (evenRequired && count % 2 !== 0) { count++; countInput.value = count; }

      const raw = count * size;
      let usable = 0;
      let fault = 0;
      let blocks = []; // 'd' data, 'p' parity, 'm' mirror, 'u' unused

      if (level === 0) {
        usable = raw;
        fault = 0;
        for (let i = 0; i < count; i++) blocks.push('d');
      } else if (level === 1) {
        usable = size;
        fault = 1;
        blocks.push('d');
        blocks.push('m');
      } else if (level === 5) {
        usable = (count - 1) * size;
        fault = 1;
        for (let i = 0; i < count; i++) blocks.push(i === count - 1 ? 'p' : 'd'); // simplified visualization
      } else if (level === 6) {
        usable = (count - 2) * size;
        fault = 2;
        for (let i = 0; i < count; i++) blocks.push(i >= count - 2 ? 'p' : 'd');
      } else if (level === 10) {
        usable = (count / 2) * size;
        fault = 1;
        for (let i = 0; i < count; i++) blocks.push(i % 2 === 0 ? 'd' : 'm');
      }

      rawEl.textContent = raw.toFixed(1) + ' TB';
      usableEl.textContent = usable.toFixed(1) + ' TB';
      faultEl.textContent = fault + ' Drive' + (fault !== 1 ? 's' : '');

      // Generate mdadm command
      let devString = '';
      let driveLetters = 'bcdefghijklmnopqrstuvwxyz';
      for (let i = 0; i < count; i++) {
        devString += ' /dev/sd' + driveLetters[i % driveLetters.length];
      }
      document.getElementById('raid-command').textContent = `mdadm --create --verbose /dev/md0 --level=${level} --raid-devices=${count}${devString}`;

      // Render Visual
      visual.innerHTML = '';
      for (let i = 0; i < count; i++) {
        let color = '#e2e8f0'; // default unused
        let type = blocks[i] || 'u';
        let delay = i * 0.3; // Staggered drop

        if (level === 1) delay = 0; // Both drives same time
        if (level === 10) delay = Math.floor(i / 2) * 0.4; // Mirrors sync

        if (type === 'd') color = '#3b82f6';
        if (type === 'p') color = '#f59e0b';
        if (type === 'm') color = '#10b981';

        let animHtml = type !== 'u' ? `<div style="position:absolute; top:0; left:50%; width:24px; height:6px; background:${color}; border-radius:2px; border:1px solid rgba(0,0,0,0.2); animation: dropData 1.5s infinite ease-in; animation-delay: ${delay}s; z-index:5;"></div>` : '';

        visual.innerHTML += `
          <div class="bb-static" style="background:#fff; display:flex; flex-direction:column; align-items:center; padding:10px 5px; height:140px; position:relative; overflow:hidden; border:var(--border);">
            ${animHtml}
            <div style="width:80%; height:8px; background:#cbd5e1; border-radius:4px; margin-bottom:8px; z-index:10; position:relative;"></div>
            <div style="width:80%; flex:1; border:1px solid #cbd5e1; display:flex; flex-direction:column; z-index:10; position:relative; background:#f8fafc;">
              <div style="flex:1; background:${color}; opacity:0.8; margin:2px;"></div>
              <div style="flex:1; background:${color}; opacity:0.6; margin:2px;"></div>
              <div style="flex:1; background:${color}; opacity:0.4; margin:2px;"></div>
            </div>
            <div style="font-size:0.6rem; font-weight:700; margin-top:5px; font-family:'Space Mono', monospace; z-index:10; position:relative;">HDD ${i + 1}</div>
          </div>
        `;
      }
    }

    function randomPalette() {
      const btn = document.getElementById('btn-random');
      if (btn) {
        btn.classList.remove('spin');
        void btn.offsetWidth; // trigger reflow to restart animation
        btn.classList.add('spin');
      }
      const palettes = [
        { p: '#3b82f6', s: '#8b5cf6', a: '#f59e0b', bg: '#f8fafc', t: '#0f172a' },
        { p: '#10b981', s: '#059669', a: '#ef4444', bg: '#ecfdf5', t: '#064e3b' },
        { p: '#f43f5e', s: '#e11d48', a: '#f59e0b', bg: '#fff1f2', t: '#4c0519' },
        { p: '#6366f1', s: '#4f46e5', a: '#ec4899', bg: '#eef2ff', t: '#312e81' },
        { p: '#0ea5e9', s: '#0284c7', a: '#f97316', bg: '#f0f9ff', t: '#0c4a6e' },
        { p: '#8b5cf6', s: '#7c3aed', a: '#14b8a6', bg: '#f5f3ff', t: '#2e1065' },
        { p: '#14b8a6', s: '#0f766e', a: '#f59e0b', bg: '#f0fdfa', t: '#134e4a' },
        { p: '#f97316', s: '#ea580c', a: '#3b82f6', bg: '#fff7ed', t: '#7c2d12' }
      ];
      const rand = palettes[Math.floor(Math.random() * palettes.length)];
      document.getElementById('cp-primary').value = rand.p;
      document.getElementById('cp-secondary').value = rand.s;
      document.getElementById('cp-accent').value = rand.a;
      document.getElementById('cp-bg').value = rand.bg;
      document.getElementById('cp-text').value = rand.t;
      updatePalette();
    }

    function updatePalette() {
      const p = document.getElementById('cp-primary').value;
      const s = document.getElementById('cp-secondary').value;
      const a = document.getElementById('cp-accent').value;
      const bg = document.getElementById('cp-bg').value;
      const t = document.getElementById('cp-text').value;

      const mock = document.getElementById('mock-site');
      if (mock) {
        mock.style.setProperty('--m-primary', p);
        mock.style.setProperty('--m-secondary', s);
        mock.style.setProperty('--m-accent', a);
        mock.style.setProperty('--m-bg', bg);
        mock.style.setProperty('--m-text', t);
      }

      const configStr = `module.exports = {
  theme: {
    extend: {
      colors: {
        primary: '${p}',
        secondary: '${s}',
        accent: '${a}',
        background: '${bg}',
        text: '${t}',
      }
    }
  }
}`;
      const confEl = document.getElementById('tw-config');
      if (confEl) confEl.textContent = configStr;
    }

    // API Tester Logic
    async function sendApiRequest() {
      const url = document.getElementById('api-url').value;
      const method = document.getElementById('api-method').value;
      const body = document.getElementById('api-body').value;
      const statusEl = document.getElementById('api-status');
      const timeEl = document.getElementById('api-time');
      const responseEl = document.getElementById('api-response');

      if (!url) {
        responseEl.textContent = "Error: Please enter a URL.";
        responseEl.style.color = "#ef4444";
        return;
      }

      responseEl.textContent = "Loading...";
      responseEl.style.color = "#94a3b8";
      statusEl.textContent = "---";
      timeEl.textContent = "---";

      const options = {
        method: method,
        headers: {}
      };

      if (['POST', 'PUT', 'PATCH'].includes(method) && body) {
        try {
          JSON.parse(body);
          options.headers['Content-Type'] = 'application/json';
        } catch (e) { }
        options.body = body;
      }

      const startTime = performance.now();

      try {
        const response = await fetch(url, options);
        const endTime = performance.now();

        statusEl.textContent = `${response.status} ${response.statusText}`;
        statusEl.style.color = response.ok ? '#10b981' : '#ef4444';
        timeEl.textContent = `${Math.round(endTime - startTime)} ms`;

        const contentType = response.headers.get("content-type");
        if (contentType && contentType.includes("application/json")) {
          const json = await response.json();
          responseEl.textContent = JSON.stringify(json, null, 2);
          responseEl.style.color = "#a5b4fc";
        } else {
          const text = await response.text();
          responseEl.textContent = text;
          responseEl.style.color = "#f8fafc";
        }

      } catch (error) {
        const endTime = performance.now();
        timeEl.textContent = `${Math.round(endTime - startTime)} ms`;
        statusEl.textContent = "ERROR";
        statusEl.style.color = "#ef4444";

        responseEl.textContent = `Fetch Error: ${error.message}\n\nNote: This is often caused by CORS (Cross-Origin Resource Sharing) restrictions on the target server.`;
        responseEl.style.color = "#ef4444";
      }
    }

    // Initialize
    updateRaid();
    updatePalette();
    document.title = "Adly Fahreza - Personal Web — Tools";
  </script>

</Layout>
