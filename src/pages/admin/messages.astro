---
import Layout from '../../layouts/Layout.astro';
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3005';
---
<Layout title="Adly Fahreza - Personal Web — Admin Messages">

  <!-- LOCK SCREEN OVERLAY (AUTHENTICATION GATE) -->
  <div id="auth-lock-screen" style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding: 4rem 2rem; min-height: 60vh;">
    <div class="bb-static bg-white p-8 md:p-12 text-[#111111] w-full max-w-[400px] text-center" style="border: var(--border); border-radius: 12px; box-shadow: none;">
      <div style="font-family:'Space Mono', monospace; font-size:10px; color:#d30005; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; margin-bottom: 1rem; display:flex; align-items:center; justify-content:center; gap:6px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        SECURE GATEWAY
      </div>
      <h2 style="font-family:'Bebas Neue', sans-serif; font-size: 2.2rem; line-height: 0.95; text-transform: uppercase; font-weight: 500; color: #111111; letter-spacing: -0.01em; margin-bottom: 0.5rem;">
        ACCESS RESTRICTED
      </h2>
      <p style="font-size:12px; color:#707072; font-weight:500; margin-bottom: 2rem; line-height:1.5;">
        Please enter the private administrative access key to decrypt and view messages.
      </p>

      <form id="auth-form" onsubmit="handleAuthSubmit(event)" class="flex flex-col gap-3">
        <input type="password" id="admin-passkey" required placeholder="Access Key..." style="width:100%; border:1.5px solid #cacacb; border-radius:6px; padding:10px 14px; font-size:13px; font-family:'Space Mono', monospace; text-align:center; outline:none; background:#fcfcfc;">
        <div id="auth-error-msg" style="display:none; font-family:'Space Mono', monospace; font-size:10px; font-weight:700; color:#d30005; background:#fffde7; padding:6px; border-radius:4px;"></div>
        <button type="submit" class="gb-btn w-full" style="background:#111111; color:#ffffff; font-weight:700; border-radius:6px; height:42px; cursor:pointer; font-family:'Space Mono', monospace; font-size:12px; transition:all 0.2s ease; border:1.5px solid #111111;" onmouseover="this.style.background='transparent'; this.style.color='#111111';" onmouseout="this.style.background='#111111'; this.style.color='#ffffff';">AUTHENTICATE</button>
      </form>
    </div>
  </div>

  <!-- ADMIN MESSAGE BOARD CONTAINER (HIDDEN UNTIL AUTHENTICATED) -->
  <div id="admin-dashboard-container" class="max-w-6xl mx-auto px-4 py-8" style="display:none;">
    
    <!-- HEADER -->
    <div class="bb-static mb-8 overflow-hidden fi d1 bg-[#111111] text-white p-8 md:p-12 relative" style="border-radius: 12px;">
      <div class="absolute top-4 left-4 border border-white/20 text-white/40 text-[9px] font-mono tracking-widest uppercase px-2 py-0.5">
        ADMIN PANEL // SECURE ACCESS
      </div>
      <div class="absolute top-4 right-4">
        <button onclick="handleLogout()" style="background:transparent; border: 1px solid rgba(255,255,255,0.2); color:#cacacb; font-family:'Space Mono', monospace; font-size:9px; font-weight:700; padding:4px 10px; border-radius:4px; cursor:pointer; transition:all 0.2s ease;" onmouseover="this.style.borderColor='white'; this.style.color='white';" onmouseout="this.style.borderColor='rgba(255,255,255,0.2)'; this.style.color='#cacacb';">
          SECURE LOGOUT
        </button>
      </div>
      <h1 style="font-family:'Bebas Neue', sans-serif; font-size: 64px; line-height: 0.9; text-transform: uppercase; font-weight: 500; letter-spacing: -0.01em;" class="mt-4">
        REACH OUT INBOX
      </h1>
      <p style="font-size:.85rem;margin-top:.5rem;color:#cacacb;max-width:560px;font-weight:500;line-height:1.6;">
        Administrative console displaying all messages submitted through the public "Get in Touch" form.
      </p>
    </div>

    <!-- MESSAGES LIST -->
    <div class="fi d2">https://adeli.tech/
      <div class="bb-static bg-white p-6 md:p-8 text-[#111111]" style="border: var(--border); border-radius: 12px; box-shadow: none;">
        <div style="font-family:'Bebas Neue'; font-size:1.8rem; border-bottom: 2px solid #111111; padding-bottom: 4px; margin-bottom: 1.5rem; color:#111111; display:flex; justify-content:between; align-items:center; flex-wrap:wrap; gap:10px;">
          <span>RECEIVED MESSAGES (<span id="messages-count">0</span>)</span>
          <button onclick="fetchMessages()" style="font-family:'Space Mono', monospace; font-size:10px; font-weight:700; padding:6px 12px; background:#f5f5f5; border:1px solid #cacacb; border-radius:6px; cursor:pointer; transition:all 0.2s ease; display:flex; align-items:center; gap:6px;" onmouseover="this.style.borderColor='#111111'; this.style.background='#ffffff';" onmouseout="this.style.borderColor='#cacacb'; this.style.background='#f5f5f5';">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
            REFRESH
          </button>
        </div>

        <div id="messages-loader" style="text-align:center; padding:3rem; font-family:'Space Mono', monospace; font-size:12px; color:#707072; font-weight:700;">
          FETCHING SYSTEM INBOX...
        </div>

        <div id="no-messages-view" style="display:none; text-align:center; padding:4rem 2rem; border:1.5px dashed #cacacb; border-radius:8px;">
          <div style="font-family:'Space Mono', monospace; font-size:11px; font-weight:700; color:#707072; margin-bottom:0.5rem;">INBOX EMPTY</div>
          <p style="font-size:12px; color:#707072; font-weight:500; margin:0;">No reach messages have been submitted yet.</p>
        </div>
https://adeli.tech/
        <div id="messages-table-wrapper" class="overflow-x-auto" style="display:none;">
          <table style="width:100%; border-collapse: collapse; font-size:13px; text-align:left;">
            <thead>
              <tr style="border-bottom:2px solid #111111https://adeli.tech/; font-family:'Space Mono', monospace; font-size:10px; font-weight:700; text-transform:uppercase; color:#707072;">
                <th style="padding:12px 8px;">Date</th>
                <th style="padding:12px 8px;">Sender</th>
                <th style="padding:12px 8px;">Subject</th>
                <th style="padding:12px 8px;">Message</th>
              </tr>
            </thead>
            <tbody id="messages-list-tbody">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiUrl }}>https://adeli.tech/
    window.PUBLIC_API_URL = apiUrl;
  </script>

  <script is:inline>
    const API_URL = window.PUBLIC_API_URL || 'http://localhost:3005';
    const EXPECTED_SECRET = 'adlyadmin2026';

    function checkAuth() {
      const storedKey = localStorage.getItem('admin_access_token');
      const lockScreen = document.getElementById('auth-lock-screen');
      const dashboard = document.getElementById('admin-dashboard-container');

      if (storedKey === EXPECTED_SECRET) {
        lockScreen.style.display = 'none';
        dashboard.style.display = 'block';
        fetchMessages();
      } else {
        lockScreen.style.display = 'flex';
        dashboard.style.display = 'none';
      }
    }

    function handleAuthSubmit(e) {
      if (e) e.preventDefault();
      const enteredKey = document.getElementById('admin-passkey').value;
      const errorMsg = document.getElementById('auth-error-msg');

      if (enteredKey === EXPECTED_SECRET) {
        localStorage.setItem('admin_access_token', enteredKey);
        if (errorMsg) errorMsg.style.display = 'none';
        checkAuth();
      } else {
        if (errorMsg) {
          errorMsg.style.display = 'block';
          errorMsg.textContent = 'INVALID ACCESS KEY. DENIED.';
        }
      }
    }

    function handleLogout() {
      localStorage.removeItem('admin_access_token');
      location.reload();
    }

    async function fetchMessages() {
      const loader = document.getElementById('messages-loader');
      const emptyView = document.getElementById('no-messages-view');
      const tableWrapper = document.getElementById('messages-table-wrapper');
      const tbody = document.getElementById('messages-list-tbody');
      const countLabel = document.getElementById('messages-count');
      const secret = localStorage.getItem('admin_access_token') || '';

      loader.style.display = 'block';
      emptyView.style.display = 'none';
      tableWrapper.style.display = 'none';
      if (tbody) tbody.innerHTML = '';

      try {
        const response = await fetch(`${API_URL}/api/contacts?secret=${secret}`);
        if (!response.ok) {
          throw new Error('Unauthorized or failed to retrieve messages');
        }
        const data = await response.json();
        
        if (data.success && data.contacts && data.contacts.length > 0) {
          countLabel.textContent = data.contacts.length;
          
          data.contacts.forEach(msg => {
            const tr = document.createElement('tr');
            tr.style.borderBottom = '1px solid #cacacb';
            tr.style.verticalAlign = 'top';
            
            // Format timestamp nicely
            const dateStr = new Date(msg.timestamp).toLocaleString('en-US', {
              month: 'short',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            });

            tr.innerHTML = `
              <td style="padding:16px 8px; font-family:'Space Mono', monospace; font-size:11px; white-space:nowrap; font-weight:700;">${dateStr}</td>
              <td style="padding:16px 8px; font-weight:600;">
                <div style="color:#111111;">${escapeHTML(msg.name)}</div>
                <div style="font-family:'Space Mono', monospace; font-size:10px; color:#707072; margin-top:2px;">${escapeHTML(msg.email)}</div>
              </td>
              <td style="padding:16px 8px; font-weight:700; color:#111111;">${escapeHTML(msg.subject || '—')}</td>
              <td style="padding:16px 8px; color:#4b5563; line-height:1.5; font-weight:500; white-space: pre-wrap;">${escapeHTML(msg.message)}</td>
            `;
            tbody.appendChild(tr);
          });
          
          loader.style.display = 'none';
          tableWrapper.style.display = 'block';
        } else {
          countLabel.textContent = '0';
          loader.style.display = 'none';
          emptyView.style.display = 'block';
        }
      } catch (err) {
        loader.style.display = 'block';
        loader.style.color = '#d30005';
        loader.textContent = `CRITICAL INBOX FAILURE: ${err.message}`;
      }
    }

    function escapeHTML(str) {
      if (!str) return '';
      return str.replace(/[&<>'"]/g, 
        tag => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[tag] || tag)
      );
    }

    // Run auth check on load
    window.onload = checkAuth;
    window.handleAuthSubmit = handleAuthSubmit;
    window.handleLogout = handleLogout;
    window.fetchMessages = fetchMessages;
  </script>

</Layout>
