    let ALL_GALLERY_IMAGES = [];
    function renderGallery(images, animateNow = false) {
      const grid = document.getElementById('gallery-grid');
      const empty = document.getElementById('gallery-empty');
      if (!images.length) { grid.style.display = 'none'; empty.style.display = 'block'; return; }
      grid.style.display = ''; empty.style.display = 'none';

      // To make Masonry (columns) look "Left-to-Right" ordered:
      // We distribute images into columns manually in the array.
      let cols = 3;
      if (window.innerWidth <= 480) cols = 1;
      else if (window.innerWidth <= 768) cols = 2;

      let orderedImages = images;
      if (cols > 1) {
        orderedImages = [];
        for (let c = 0; c < cols; c++) {
          for (let i = c; i < images.length; i += cols) {
            orderedImages.push(images[i]);
          }
        }
      }

      grid.innerHTML = orderedImages.map((img, i) => `
    <div class="gallery-img ${animateNow ? 'run-anim' : ''}" style="break-inside:avoid;margin-bottom:10px;background:${HOVERS[i % HOVERS.length]};${animateNow ? `animation-delay:${i * 200}ms;` : ''}" onclick="openLB('${img.src}','${img.title}')">
      <img src="${img.src}" alt="${img.title}" style="width:100%;height:auto;display:block;"
           onerror="this.style.display='none';this.parentElement.querySelector('.img-fallback').style.display='flex'">
      <div class="overlay">${img.title.toUpperCase()} ↗</div>
      <div class="img-fallback" style="display:none;flex-direction:column;align-items:center;justify-content:center;padding:1.5rem;text-align:center;min-height:80px;">
        <div style="font-size:1.5rem;">🖼️</div>
        <div style="font-size:.62rem;font-weight:700;margin-top:4px;">${img.title}</div>
      </div>
    </div>`).join('');
