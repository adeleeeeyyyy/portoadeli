    async function loadRepos(u) {
      try {
        const repos = offlineData ? offlineData.repos : await get(`${API}/users/${USERNAME}/repos?sort=updated&per_page=100`);
        const sorted = [...repos].sort((a, b) => b.stargazers_count - a.stargazers_count);
        document.getElementById('stat-stars').textContent = sorted.reduce((s, r) => s + r.stargazers_count, 0);
        const { level, xp, pct } = calcLevel(u, repos);
        document.getElementById('user-level').textContent = level;
        document.getElementById('xp-label').textContent = xp + ' XP';
        setTimeout(() => { document.getElementById('xp-fill').style.width = pct + '%'; }, 300);
        // langs
        const lc = {}; repos.forEach(r => { if (r.language) lc[r.language] = (lc[r.language] || 0) + 1; });
        const lt = Object.values(lc).reduce((a, b) => a + b, 0) || 1;
        const langs = Object.entries(lc).sort((a, b) => b[1] - a[1]).slice(0, 7);
        let curPct = 0;
        let gradStops = [];
        langs.forEach(([l, c]) => {
          const pct = (c / lt) * 100;
          const bGap = Math.min(1.5, pct / 3);
          gradStops.push(`${LC(l)} ${curPct + bGap}%`, `${LC(l)} ${curPct + pct - bGap}%`);
          curPct += pct;
        });

        document.getElementById('lang-list').innerHTML = langs.map(([l, c]) => `
        <div style="display:flex;align-items:center;justify-content:space-between;font-size:.68rem;padding:6px 0;border-bottom:1px solid var(--hairline-soft);font-weight:600;">
          <div style="display:flex;align-items:center;gap:6px;">
            <div style="width:10px;height:10px;border-radius:50%;background-color:${LC(l)};border:1px solid var(--ink);flex-shrink:0;"></div><b>${l.toUpperCase()}</b>
          </div>
          <span style="color:#707072;">${Math.round(c / lt * 100)}%</span>
        </div>`).join('');
        // showcase
        document.getElementById('showcase-grid').innerHTML = sorted.slice(0, 4).map((r, i) => `
      <a href="${r.html_url}" target="_blank" class="showcase-card"
         style="background:var(--soft-cloud); border:1px solid var(--hairline); color:var(--ink); transition:all 0.2s cubic-bezier(0.16, 1, 0.3, 1);"
         onmouseover="this.style.background='var(--ink)';this.style.color='var(--canvas)';this.style.borderColor='var(--ink)';" onmouseout="this.style.background='var(--soft-cloud)';this.style.color='var(--ink)';this.style.borderColor='var(--hairline)';">
        <div style="display:flex;align-items:start;justify-content:space-between;gap:6px;">
          <div><div style="font-family:'Bebas Neue';font-weight:500;font-size:1.25rem;letter-spacing:0.02em;">${r.name.toUpperCase()}</div>${r.fork ? '<span class="tag" style="font-size:.5rem;padding:2px 8px;background:var(--canvas);margin-top:2px;">fork</span>' : ''}</div>
          <div style="text-align:right;font-size:.68rem;flex-shrink:0;font-weight:700;"><div>★ ${r.stargazers_count}</div><div>⑂ ${r.forks_count}</div></div>
        </div>
        <p style="font-size:.68rem;line-height:1.55;margin:.5rem 0;font-weight:500;opacity:0.8;">${r.description || '<em>No description available.</em>'}</p>
        <div style="display:flex;gap:5px;flex-wrap:wrap;align-items:center;margin-top:auto;">
          ${r.language ? `<div style="display:flex;align-items:center;gap:3px;font-size:.62rem;font-weight:700;"><div style="width:7px;height:7px;background:${LC(r.language)};border:1px solid var(--ink);"></div>${r.language.toUpperCase()}</div>` : ''}
          ${(r.topics || []).slice(0, 2).map(t => `<span class="tag" style="font-size:.5rem;padding:2px 8px;background:var(--canvas);">${t.toUpperCase()}</span>`).join('')}
          <span style="font-size:.58rem;margin-left:auto;font-weight:700;opacity:0.6;">${ago(r.updated_at).toUpperCase()}</span>
        </div>
      </a>`).join('');
        // repos list - Bento style
        const reposEl = document.getElementById('repos-grid');
        reposEl.classList.add('bento-grid');
        reposEl.innerHTML = sorted.map((r, i) => {
          const isMain = i < 2; // Make first two bigger
