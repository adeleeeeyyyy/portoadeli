        return;
      }

      if (tr) {
        if (tip.dataset.activeType === 'role' && tip.dataset.activeRole === tr.dataset.role && tip.style.opacity === '1') return;
        tip.dataset.activeType = 'role';
        tip.dataset.activeRole = tr.dataset.role;

        const rect = tr.getBoundingClientRect();
        tip.style.left = Math.min(rect.left + window.scrollX, window.innerWidth - 320) + 'px';
        tip.style.top = rect.bottom + window.scrollY + 10 + 'px';
        tip.style.display = 'block';

        const role = tr.dataset.role;
        let header = '';
        let frames = [];
        if (role === 'sysadmin') {
          header = `<div style="color:#059669;margin-bottom:6px;font-weight:700;">root@srv-01:~# systemctl status nginx</div>`;
          const l = [`[....] Checking proxy...`, `[ ok ] ngx_http_core_module`, `[....] Reloading config...`, `[ ok ] Reloaded config`, `root@srv-01:~# <span style="animation:blink 1s step-end infinite;">_</span>`];
          frames = l.map((_, idx) => l.slice(0, idx + 1).join('<br>'));
        } else if (role === 'designer') {
          header = `<div style="color:#d97706;margin-bottom:8px;font-family:'Outfit',sans-serif;font-weight:700;letter-spacing:.05em;">$  ./graphic_design.sh</div>`;
          const lines = ["  ____                 _     _      ", " / ___|_ __ __ _ _ __ | |__ (_) ___ ", "| |  _ | '__/ _\` | '_ \\| '_ \\| |/ __|", "| |_| || | | (_| | |_) | |_) | | (__ ", " \\____||_|  \\__,_| .__/|_.__/|_|\\___|", "                 |_|                 ", "       _                             ", "      | |                            ", "    __| |___ ___ ___ __ _ _ __  ___  ", "   / _\` |/ _ \\ __| |/ _\` | '_ \\ / _ \\ ", "  | (_| |  __\\__ \\ | (_| | | | |  __/ ", "   \\__,_|\\___|___/_|\\__,_|_| |_|\\___| "];
          frames = lines.map((_, idx) => `<div style="font-family:monospace;font-size:7.5px;line-height:1.2;color:#f59e0b;white-space:pre;font-weight:700;">${lines.slice(0, idx + 1).join('<br>')}</div>`);
        } else if (role === 'backend') {
          header = `<div style="color:#2563eb;margin-bottom:6px;font-weight:700;">$ go run server.go</div>`;
          const l = [`Initializing router...`, `[INFO] Connected to PostgreSQL`, `[INFO] Redis Cache ready`, `⇨ http server started on :8080`, `<span style="animation:blink 1s step-end infinite;">_</span>`];
          frames = l.map((_, idx) => l.slice(0, idx + 1).join('<br>'));
        }

        tip.innerHTML = header + `<div id="tt-content" style="color:#64748b;min-height:120px;line-height:1.5;"></div>`;
        const content = document.getElementById('tt-content');
        requestAnimationFrame(() => {
          tip.style.opacity = '1';
          tip.style.transform = 'translateY(0)';
        });

        clearInterval(window.tooltipAnimInterval);
        let i = 0;
        content.innerHTML = frames[0];
        window.tooltipAnimInterval = setInterval(() => {
          i++;
          if (i < frames.length) {
            content.innerHTML = frames[i];
          } else if (i > frames.length + 2) {
            i = 0;
            content.innerHTML = frames[0];
          }
        }, 250);
      }
    });

    function initMatrix() {
      const canvas = document.getElementById('cmatrix');
      if (!canvas || canvas.dataset.matrixInit) return;
      canvas.dataset.matrixInit = '1';
      const ctx = canvas.getContext('2d');
      const resize = () => { canvas.width = canvas.parentElement.offsetWidth; canvas.height = canvas.parentElement.offsetHeight; };
      resize();
      const chars = '01ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ'.split('');
      const fontSize = 14;
      const columns = canvas.width / fontSize;
      const drops = Array(Math.ceil(columns)).fill(canvas.height);
      setInterval(() => {
        ctx.fillStyle = 'rgba(17, 17, 17, 0.15)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = 'rgba(52, 211, 153, 0.65)';
        ctx.font = fontSize + 'px monospace';
        for (let i = 0; i < drops.length; i++) {
          const text = chars[Math.floor(Math.random() * chars.length)];
          ctx.fillText(text, i * fontSize, drops[i] * fontSize);
          if (drops[i] * fontSize > canvas.height && Math.random() > 0.95) drops[i] = 0;
          drops[i]++;
        }
      }, 45);
      window.addEventListener('resize', resize);
    }

    let offlineData = null;

    async function initPage() {
      // Re-read data on every navigation (window.githubData is embedded in the HTML)
      offlineData = window.githubData || null;
      logCacheStatus();
      initMatrix();
      fillTerminalDates();

      const tStr = "./profile.sh";
      let tIdx = 0;
      const nTitle = document.getElementById('nav-title');
      if (nTitle) {
        nTitle.textContent = tStr + '_';
        const typeTitle = () => {
          if (tIdx <= tStr.length) {
            nTitle.textContent = tStr.slice(0, tIdx) + (tIdx < tStr.length ? '_' : '');
            tIdx++;
            setTimeout(typeTitle, 150);
          } else {
            setInterval(() => nTitle.textContent = tStr + (nTitle.textContent.endsWith('_') ? ' ' : '_'), 500);
          }
        };
        setTimeout(typeTitle, 300);
      }
      loadSocials();
      prepareTabAnims();

      buildCalendar();
      await renderSkills();
      preloadGallery();
      const u = await loadProfile();
      if (u) await loadRepos(u);
      await loadEvents();
      await loadVisitsChart();
      setTimeout(checkSidebarOverflow, 500);
      window.addEventListener('resize', checkSidebarOverflow);
    }

    // Run on first load and on every Astro client-side navigation back to this page
    document.addEventListener('astro:page-load', initPage);
  </script>

</Layout>
