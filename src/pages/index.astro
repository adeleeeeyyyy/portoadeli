    /* ══════════════════════════════
       COMMIT CHART — fetch from ALL repos with batching
       GitHub unauthenticated: 60 req/hr, so we batch 8 at a time
       with a small delay between batches to stay safe
    ══════════════════════════════ */
    async function buildCommitChart(allRepos) {
      const chart = document.getElementById('commit-chart');
      const labelsEl = document.getElementById('commit-chart-labels');
      const wrap = document.getElementById('commit-chart-wrap');
      const empty = document.getElementById('commit-empty');
      const tag = document.getElementById('commit-chart-tag');

      // Show loading state
      tag.textContent = 'LOADING...';
      chart.innerHTML = '<div style="font-size:.65rem;color:#aaa;padding:.5rem 0;">fetching commits from all repos...</div>';

      const DAYS = 14;
      const counts = new Array(DAYS).fill(0);
      const today = new Date(); today.setHours(23, 59, 59, 999);
      const since = new Date(today - (DAYS - 1) * 864e5); since.setHours(0, 0, 0, 0);

      // Filter out forks to save requests (forks unlikely to have owner commits)
      const ownRepos = allRepos.filter(r => !r.fork);

      // Batch fetch: 8 repos at a time
      const BATCH = 8;
      for (let i = 0; i < ownRepos.length; i += BATCH) {
        const batch = ownRepos.slice(i, i + BATCH);
        await Promise.allSettled(batch.map(async repo => {
          try {
            const commits = await get(
              `${API}/repos/${USERNAME}/${repo.name}/commits?author=${USERNAME}&since=${since.toISOString()}&per_page=100`
            );
            if (!Array.isArray(commits)) return;
            commits.forEach(c => {
              const d = new Date(c.commit?.author?.date); d.setHours(0, 0, 0, 0);
              const diff = Math.round((today - d) / 864e5);
              if (diff >= 0 && diff < DAYS) counts[DAYS - 1 - diff]++;
            });
          } catch { }
        }));
        // small pause between batches to respect rate limits
        if (i + BATCH < ownRepos.length) await new Promise(r => setTimeout(r, 300));
      }

      const total = counts.reduce((a, b) => a + b, 0);
      tag.textContent = total + ' COMMITS / 14D';

      if (total === 0) {
        wrap.style.display = 'none';
        empty.style.display = 'block';
        return;
      }
      wrap.style.display = '';
      empty.style.display = 'none';

      const max = Math.max(...counts, 1);
      const dayNames = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];
      chart.innerHTML = counts.map((c, i) => {
        const date = new Date(today); date.setDate(date.getDate() - (DAYS - 1 - i));
        const h = Math.max(3, Math.round(c / max * 72));
        const bg = c === 0 ? '#e8e4dc' : HOVERS[i % HOVERS.length];
        return `<div class="chart-bar" data-tip="${c} commit${c !== 1 ? 's' : ''}">
      <div class="chart-bar-fill" style="height:${h}px;background:${bg};"></div>
    </div>`;
      }).join('');
      labelsEl.innerHTML = counts.map((_, i) => {
        const date = new Date(today); date.setDate(date.getDate() - (DAYS - 1 - i));
        return `<div style="flex:1;text-align:center;font-size:.5rem;color:#888;">${dayNames[date.getDay()]}</div>`;
      }).join('');
    }

    /* ══════════════════════════════
       SIDEBAR OVERFLOW — move excess sidebar items into main column
       Runs after all content is loaded
    ══════════════════════════════ */
    function checkSidebarOverflow() {
      const sidebar = document.getElementById('sidebar');
      const mainCol = document.getElementById('main-col');
      if (!sidebar || !mainCol) return;
      // only on desktop (lg: 1024px+)
      if (window.innerWidth < 1024) return;

      const mainBottom = mainCol.getBoundingClientRect().bottom;
      const sidebarItems = Array.from(sidebar.children);

      sidebarItems.forEach(item => {
        const itemBottom = item.getBoundingClientRect().bottom;
        if (itemBottom > mainBottom + 40) {
          // move this card into main column, before contribution calendar
          item.style.marginTop = '0';
          const cal = document.getElementById('cal-wrap');
          if (cal) mainCol.insertBefore(item, cal);
          else mainCol.appendChild(item);
        }
      });
    }

    /* ══════════════════════════════
       CONTRIBUTION CALENDAR
    ══════════════════════════════ */
    function buildCalendar() {
      const weeks = document.getElementById('cal-weeks');
      const bg = ['#f1f5f9', '#cbd5e1', '#94a3b8', '#64748b', '#475569'];
      const WEEKS = 52; const today = new Date();
      let monthMap = {}; let html = '';
      for (let w = 0; w < WEEKS; w++) {
        html += '<div style="display:flex;flex-direction:column;gap:2px;">';
        for (let d = 0; d < 7; d++) {
          const date = new Date(today); date.setDate(date.getDate() - ((WEEKS - 1 - w) * 7 + (6 - d)));
          const lvl = Math.floor(Math.random() * 5);
          if (d === 0) monthMap[w] = date.toLocaleDateString('en', { month: 'short' });
          html += `<div class="adot" data-tip="${date.toDateString()}" style="background:${bg[lvl]};"></div>`;
        }
        html += '</div>';
      }
      weeks.innerHTML = html;
      let prev = ''; let mhtml = '';
      for (let w = 0; w < WEEKS; w++) {
        const m = monthMap[w] || '';
        if (m !== prev) { mhtml += `<div style="min-width:${(WEEKS - w) * 14}px;max-width:56px;">${m}</div>`; prev = m; }
      }
      document.getElementById('cal-months').innerHTML = mhtml;
      const total = Array.from(weeks.querySelectorAll('.adot')).filter(d => d.style.background !== 'rgb(240, 236, 232)').length;
      document.getElementById('contrib-label').textContent = total + ' contributions this year';
    }

    /* ══════════════════════════════
