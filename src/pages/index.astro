    /* ══════════════════════════════
       NOW PLAYING — locked music player
       To customize: edit NP_TRACKS below.
       album art: put album.jpg (or per-track) next to index.html
    ══════════════════════════════ */
    const NP_TRACKS = [
      { title: 'Song Title', artist: 'Artist Name', art: 'album.jpg', dur: 227 },
      // add more tracks here:
      // { title: 'Another Song', artist: 'Other Artist', art: 'album2.jpg',  dur: 180 },
    ];

    let npIdx = 0;
    let npSec = 0;
    let npPlaying = true;
    let npTimer = null;

    function npCurrent() { return NP_TRACKS[npIdx % NP_TRACKS.length]; }

    function npRender() {
      const t = npCurrent();
      const artImg = document.getElementById('np-art-img');
      const fallback = document.getElementById('np-art-fallback');
      artImg.src = t.art;
      artImg.style.display = 'block';
      fallback.style.display = 'none';
      artImg.onerror = () => { artImg.style.display = 'none'; fallback.style.display = 'flex'; };
      document.getElementById('np-title').textContent = t.title;
      document.getElementById('np-artist').textContent = t.artist;
      document.getElementById('np-dur').textContent = npFmt(t.dur);
      // dots
      const dots = document.getElementById('np-dots');
      if (NP_TRACKS.length > 1) {
        dots.innerHTML = NP_TRACKS.map((_, i) =>
          `<div style="width:6px;height:6px;border-radius:50%;border:1.5px solid var(--ink);background:${i === npIdx ? 'var(--ink)' : 'transparent'};transition:background .2s;"></div>`
        ).join('');
      }
    }

    function npFmt(s) { return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; }

    function npTick() {
      if (!npPlaying) return;
      const t = npCurrent();
      npSec++;
      if (npSec >= t.dur) { npSec = 0; npNext(); return; }
      const pct = npSec / t.dur * 100;
      document.getElementById('np-progress').style.width = pct + '%';
      document.getElementById('np-cur').textContent = npFmt(npSec);
    }

    function npToggle() {
      npPlaying = !npPlaying;
      document.getElementById('np-playbtn').textContent = npPlaying ? '⏸' : '▶';
      document.getElementById('np-status').textContent = npPlaying ? 'PLAYING' : 'PAUSED';
      document.getElementById('np-bars').classList.toggle('paused', !npPlaying);
      const vinyl = document.getElementById('np-vinyl-icon');
      if (vinyl) vinyl.classList.toggle('playing', npPlaying);
    }

    function npNext() {
      npIdx = (npIdx + 1) % NP_TRACKS.length;
      npSec = 0;
      document.getElementById('np-progress').style.width = '0%';
      npRender();
    }
    function npPrev() {
      if (npSec > 3) { npSec = 0; document.getElementById('np-progress').style.width = '0%'; return; }
      npIdx = (npIdx - 1 + NP_TRACKS.length) % NP_TRACKS.length;
      npSec = 0;
      document.getElementById('np-progress').style.width = '0%';
      npRender();
    }
    function npSeek(e) {
      const wrap = document.getElementById('np-progress-wrap');
      const rect = wrap.getBoundingClientRect();
      const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      npSec = Math.floor(pct * npCurrent().dur);
      document.getElementById('np-progress').style.width = (pct * 100) + '%';
      document.getElementById('np-cur').textContent = npFmt(npSec);
    }
    function initNp() {
      npRender();
      document.getElementById('np-playbtn').textContent = '⏸';
      setInterval(npTick, 1000);
    }

