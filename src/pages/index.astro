  <script is:inline>
    const USERNAME = 'adeleeeeyyyy';
    const API = 'https://api.github.com';
    const LANG_COLORS = {
      JavaScript: '#f1e05a', TypeScript: '#2b7489', Python: '#3572A5', HTML: '#e34c26',
      CSS: '#563d7c', Java: '#b07219', Go: '#00ADD8', Rust: '#dea584', 'C++': '#f34b7d',
      'C#': '#178600', Ruby: '#701516', Swift: '#ffac45', Kotlin: '#A97BFF', PHP: '#4F5D95',
      Shell: '#89e051', Vue: '#41b883', Dart: '#00B4AB', SCSS: '#c6538c', default: '#aaa'
    };
    const LC = l => LANG_COLORS[l] || LANG_COLORS.default;
    const HOVERS = ['var(--pink)', 'var(--lav)', 'var(--mint)', 'var(--peach)', 'var(--sky)', 'var(--yellow)'];
    const EV_BG = ['var(--pink)', 'var(--yellow)', 'var(--sky)', 'var(--mint)', 'var(--lav)', 'var(--peach)'];

    const ACHIEVEMENTS = [
      { id: 'first-repo', icon: '🌱', name: 'First Commit', desc: 'Created first repository', color: 'var(--mint)', check: u => u.public_repos >= 1 },
      { id: '10-repos', icon: '📦', name: 'Hoarder', desc: 'Own 10+ repositories', color: 'var(--peach)', check: u => u.public_repos >= 10 },
      { id: '50-repos', icon: '🗄️', name: 'Collector', desc: 'Own 50+ repositories', color: 'var(--yellow)', check: u => u.public_repos >= 50 },
      { id: 'follower10', icon: '👥', name: 'Popular', desc: '10+ followers', color: 'var(--lav)', check: u => u.followers >= 10 },
      { id: 'follower50', icon: '🌟', name: 'Influencer', desc: '50+ followers', color: 'var(--pink)', check: u => u.followers >= 50 },
      { id: 'veteran', icon: '🏅', name: 'Veteran', desc: 'Account > 2 years old', color: 'var(--sky)', check: u => (Date.now() - new Date(u.created_at)) > 6.3e10 },
      { id: 'og', icon: '👴', name: 'OG Dev', desc: 'Account > 5 years old', color: 'var(--peach)', check: u => (Date.now() - new Date(u.created_at)) > 1.577e11 },
      { id: 'has-bio', icon: '✍️', name: 'Storyteller', desc: 'Wrote a bio', color: 'var(--mint)', check: u => !!u.bio },
      { id: 'has-blog', icon: '🔗', name: 'Has a Website', desc: 'Linked a personal site', color: 'var(--lav)', check: u => !!u.blog },
      { id: 'hireable', icon: '💼', name: 'Open to Work', desc: 'Marked as hireable', color: 'var(--yellow)', check: u => !!u.hireable },
      { id: 'gists', icon: '📝', name: 'Gist Master', desc: 'Has public gists', color: 'var(--sky)', check: u => u.public_gists > 0 },
      { id: 'stargazer', icon: '⭐', name: 'Star Collector', desc: '10+ stars across repos', color: 'var(--pink)', check: (u, r) => r.reduce((s, x) => s + x.stargazers_count, 0) >= 10 },
    ];

    /* ── DEFAULT SKILLS DATA ── */
    /* ══════════════════════════════
       GITHUB API — cached fetch (localStorage, TTL 1 hour)
       Key: "ghc::" + url  →  { data, exp }
    ══════════════════════════════ */
    const CACHE_TTL = 60 * 60 * 1000; // 1 hour in ms

    async function get(url) {
      const key = 'ghc::' + url;
      // 1. Try cache
      try {
        const raw = localStorage.getItem(key);
        if (raw) {
          const { data, exp } = JSON.parse(raw);
          if (Date.now() < exp) return data;        // cache hit ✓
          localStorage.removeItem(key);            // expired, evict
        }
      } catch { localStorage.removeItem(key); }

      // 2. Cache miss → fetch
      const res = await fetch(url, { headers: { Accept: 'application/vnd.github.v3+json' } });
      if (!res.ok) throw res;
      const data = await res.json();

      // 3. Store in cache
      try {
        localStorage.setItem(key, JSON.stringify({ data, exp: Date.now() + CACHE_TTL }));
      } catch (e) {
        // localStorage full — evict oldest gh cache entries and retry once
        if (e.name === 'QuotaExceededError') {
          const ghKeys = Object.keys(localStorage).filter(k => k.startsWith('ghc::'));
          // sort by exp ascending, remove oldest half
          ghKeys
            .map(k => { try { return { k, exp: JSON.parse(localStorage.getItem(k)).exp }; } catch { return { k, exp: 0 }; } })
            .sort((a, b) => a.exp - b.exp)
            .slice(0, Math.max(1, Math.floor(ghKeys.length / 2)))
            .forEach(({ k }) => localStorage.removeItem(k));
          try { localStorage.setItem(key, JSON.stringify({ data, exp: Date.now() + CACHE_TTL })); } catch { }
        }
      }
      return data;
    }

    /* Helper: manually bust all GitHub cache (call from console: bustCache()) */
    function bustCache() {
      Object.keys(localStorage).filter(k => k.startsWith('ghc::')).forEach(k => localStorage.removeItem(k));
      console.log('GitHub API cache cleared. Reload to refetch.');
    }

    /* Show cache status in console on load */
    function logCacheStatus() {
      const keys = Object.keys(localStorage).filter(k => k.startsWith('ghc::'));
      const now = Date.now();
      const live = keys.filter(k => { try { return JSON.parse(localStorage.getItem(k)).exp > now; } catch { return false; } });
      console.log(`%c[GH Cache] ${live.length} live / ${keys.length} total entries. Call bustCache() to clear.`, 'color:#9060b0;font-weight:bold;');
    }
    function ago(d) { const m = Math.floor((Date.now() - new Date(d)) / 60000); if (m < 60) return m + 'm ago'; const h = Math.floor(m / 60); if (h < 24) return h + 'h ago'; return Math.floor(h / 24) + 'd ago'; }
    function etype(t) { return { PushEvent: '⬆', CreateEvent: '✦', IssuesEvent: '◉', PullRequestEvent: '⇄', WatchEvent: '★', ForkEvent: '⑂', IssueCommentEvent: '💬', ReleaseEvent: '🚀' }[t] || '◆'; }
    function edesc(e) {
      const rn = e.repo.name.split('/')[1];
      const r = `<a href="https://github.com/${e.repo.name}" target="_blank" style="font-weight:700;text-decoration:underline;">${rn}</a>`;
      switch (e.type) {
        case 'PushEvent': return `Pushed ${e.payload.commits?.length || 1} commit(s) to ${r}`;
        case 'CreateEvent': return `Created ${e.payload.ref_type} <b>${e.payload.ref || ''}</b> in ${r}`;
        case 'IssuesEvent': return `${e.payload.action} issue in ${r}`;
        case 'PullRequestEvent': return `${e.payload.action} PR in ${r}`;
        case 'WatchEvent': return `Starred ${r}`;
        case 'ForkEvent': return `Forked ${r}`;
        case 'IssueCommentEvent': return `Commented on issue in ${r}`;
        case 'ReleaseEvent': return `Released <b>${e.payload.release?.tag_name}</b> in ${r}`;
        default: return `${e.type.replace('Event', '')} in ${r}`;
      }
    }
    function calcLevel(u, repos) {
      const stars = repos.reduce((s, r) => s + r.stargazers_count, 0);
      const xp = u.public_repos * 10 + u.followers * 15 + u.following * 3 + stars * 25 + u.public_gists * 5 + Math.floor((Date.now() - new Date(u.created_at)) / 3.156e10) * 20;
      const level = Math.floor(Math.sqrt(xp / 50));
      const xpFL = level * level * 50, xpFN = (level + 1) * (level + 1) * 50;
      return { level, xp, pct: Math.min(100, Math.round((xp - xpFL) / (xpFN - xpFL) * 100)) };
    }

    function prepareTabAnims() {
      document.querySelectorAll('.tab-btn').forEach(btn => {
        const txt = btn.textContent.trim();
        btn.innerHTML = txt.split('').map((c, i) =>
          `<span data-letter="${c}" style="transition-delay:${i * 30}ms">${c === ' ' ? '&nbsp;' : c}</span>`
        ).join('');
      });
    }

    /* ── TAB ── */
    function switchTab(id) {
      const current = document.querySelector('.tab-content.active');
      if (current && current.id === 'tab-' + id) return;

      if (current) {
        current.classList.add('exit');
        current.classList.remove('active');
        setTimeout(() => {
          current.classList.remove('exit');
          current.style.display = 'none';
          
          const next = document.getElementById('tab-' + id);
          next.style.display = 'block';
          next.classList.add('active');
        }, 300);
      } else {
        const next = document.getElementById('tab-' + id);
        next.style.display = 'block';
        next.classList.add('active');
      }

