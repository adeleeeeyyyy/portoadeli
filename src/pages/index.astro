         style="grid-column:${span};background:var(--soft-cloud); border:1px solid var(--hairline); transition:all 0.2s cubic-bezier(0.16, 1, 0.3, 1);"
         onmouseover="this.style.background='var(--ink)';this.style.color='var(--canvas)';this.style.borderColor='var(--ink)';" onmouseout="this.style.background='var(--soft-cloud)';this.style.color='var(--ink)';this.style.borderColor='var(--hairline)';">
        <div style="display:flex;flex-direction:column;height:100%;justify-content:space-between;gap:8px;">
          <div>
            <div style="font-family:'Bebas Neue';font-weight:500;font-size:1.25rem;letter-spacing:0.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${r.name.toUpperCase()}</div>
            <p style="font-size:.66rem;line-height:1.5;margin-top:3px;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;white-space:normal;font-weight:500;opacity:0.8;">${r.description || '—'}</p>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:3px;flex-shrink:0;font-size:.65rem;font-weight:700;">
