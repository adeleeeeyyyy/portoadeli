    async function loadVisitsChart() {
      try {
        const res = await fetch('http://localhost:3005/api/visits');
        const json = await res.json();
        if (!json.success || !json.data) throw new Error("Failed to load visit data");
        
        const data = json.data;
        const totalVisits = data.reduce((acc, curr) => acc + curr.count, 0);
        document.getElementById('visits-sum-label').textContent = `${totalVisits} visits last 7 days`;
        
        const maxCount = Math.max(...data.map(d => d.count), 1);
        
        const container = document.getElementById('chart-bars-container');
        
        // Calculate coordinates (viewBox 0 0 600 120)
        // Leaving padding to ensure points aren't clipped at the edge
        const points = data.map((d, i) => {
          const x = i * 100;
          const y = 105 - (d.count / maxCount) * 90;
          return { x, y, ...d };
        });
        
        const pathData = `M ${points.map(p => `${p.x} ${p.y}`).join(' L ')}`;
        const areaData = `M 0 120 L ${points.map(p => `${p.x} ${p.y}`).join(' L ')} L 600 120 Z`;
        
        const svgContent = `
          <svg viewBox="0 0 600 120" width="100%" height="100%" preserveAspectRatio="none" style="overflow:visible; display:block;">
            <defs>
              <linearGradient id="area-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#707072" stop-opacity="0.15"/>
                <stop offset="100%" stop-color="#707072" stop-opacity="0.0"/>
              </linearGradient>
            </defs>
            <!-- Gridlines -->
            <line x1="0" y1="15" x2="600" y2="15" stroke="#cacacb" stroke-dasharray="4 4" stroke-width="0.5"/>
            <line x1="0" y1="60" x2="600" y2="60" stroke="#cacacb" stroke-dasharray="4 4" stroke-width="0.5"/>
            <line x1="0" y1="105" x2="600" y2="105" stroke="#cacacb" stroke-dasharray="4 4" stroke-width="0.5"/>
            
            <!-- Shaded Area Under Line (starts transparent, animated to opacity 1) -->
            <path id="chart-area-path" d="${areaData}" fill="url(#area-grad)" style="opacity:0; transition:opacity 1.2s ease 1s;"/>
            
            <!-- Connection Line (starts fully dashed and offset, animated to draw itself) -->
            <path id="chart-line-path" d="${pathData}" fill="none" stroke="#707072" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  style="stroke-dasharray:1000; stroke-dashoffset:1000; transition:stroke-dashoffset 2s cubic-bezier(0.16, 1, 0.3, 1);"/>
          </svg>
        `;
        
        // Generate interactive HTML points with tooltips that overlay perfectly on top of the SVG
        const htmlOverlay = points.map((p, i) => {
          const leftPercent = (i / 6) * 100;
          const bottomPercent = ((120 - p.y) / 120) * 100;
          return `
            <div class="absolute group chart-dot" style="left: ${leftPercent}%; bottom: calc(${bottomPercent}% - 20px); transform: translate(-50%, 0) scale(0); opacity: 0; transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) ${1.2 + i * 0.1}s; pointer-events: none; z-index: 10;">
              <!-- Hover Tooltip -->
              <div class="bg-black text-white text-[9px] font-mono py-0.5 px-2 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-auto absolute -top-8 left-1/2 transform -translate-x-1/2 whitespace-nowrap shadow-sm">
                ${p.count} visits
              </div>
              <!-- Interactive Glowing Dot -->
              <div class="w-10 h-10 rounded-full flex items-center justify-center pointer-events-auto cursor-pointer">
                <div class="w-2.5 h-2.5 bg-[#707072] rounded-full border border-white shadow-sm transition-transform duration-200 group-hover:scale-150"></div>
              </div>
            </div>
          `;
        }).join('');
        
        container.innerHTML = svgContent + htmlOverlay;
        
        const labelsContainer = document.getElementById('chart-labels-container');
        labelsContainer.innerHTML = data.map(d => `
          <span class="flex-1 text-center font-bold tracking-wider">${d.label.toUpperCase()}</span>
        `).join('');

        // Trigger animations when the chart enters the viewport
        const chartWrapper = document.getElementById('visits-chart-wrap');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              // 1. Draw connection line
              const line = document.getElementById('chart-line-path');
              if (line) line.style.strokeDashoffset = '0';
              
              // 2. Fade in shaded background area
              const area = document.getElementById('chart-area-path');
              if (area) area.style.opacity = '1';
              
              // 3. Zoom/Fade in HTML dots
              const dots = container.querySelectorAll('.chart-dot');
              dots.forEach(dot => {
                dot.style.opacity = '1';
                dot.style.transform = 'translate(-50%, 0) scale(1)';
              });
              
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });
        observer.observe(chartWrapper);

      } catch (err) {
        console.error("visits server error:", err);
        document.getElementById('chart-bars-container').innerHTML = `
          <div style="font-family:'Space Mono', monospace; font-size:.75rem; color:#ef4444; text-align:center; width:100%; padding: 3rem;">
            Failed to connect to SQLite visits server (offline)
          </div>
        `;
      }
    }



