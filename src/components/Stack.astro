---
import { stack } from '../data/site';
---

<section id="stack" data-od-id="stack" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
    <div data-reveal class="mb-14 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="font-mono text-xs uppercase tracking-widest text-ink-2">$ apt list --installed</h2>
      <p class="font-display text-3xl">Things I reach for</p>
    </div>
    <div class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        stack.map((group) => (
          <div data-reveal class="bg-paper p-7">
            <h3 class="font-mono text-xs uppercase tracking-widest text-ink-2">{group.group}</h3>
            <ul class="mt-5 space-y-2.5 font-mono text-sm">
              {group.items.map((item) => (
                <li class="flex items-center gap-2.5">
                  <svg
                    aria-hidden="true"
                    class="h-3.5 w-3.5 shrink-0"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  >
                    <path d="M2 8.5 6 12.5 14 3.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
