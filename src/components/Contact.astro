---
import { site } from '../data/site';

const icons: Record<string, string> = {
  github:
    'M8 1.5a6.5 6.5 0 0 0-2.05 12.67c.32.06.44-.14.44-.31v-1.1c-1.8.39-2.18-.86-2.18-.86-.29-.75-.72-.95-.72-.95-.58-.4.04-.39.04-.39.64.05.98.66.98.66.57.98 1.5.7 1.87.53.06-.42.22-.7.4-.86-1.42-.16-2.9-.71-2.9-3.16 0-.7.25-1.27.66-1.72-.07-.16-.29-.81.06-1.7 0 0 .53-.17 1.75.66a6 6 0 0 1 3.24 0c1.21-.83 1.75-.66 1.75-.66.35.89.13 1.54.06 1.7.41.45.66 1.02.66 1.72 0 2.46-1.49 3-2.91 3.15.23.2.43.58.43 1.17v1.73c0 .17.12.37.45.31A6.5 6.5 0 0 0 8 1.5Z',
  linkedin:
    'M4.5 5.5v9M4.5 2.6v.1M8.5 14.5v-5a2.5 2.5 0 0 1 5 0v5M8.5 9v5.5',
  mail: 'M2 4.5h12v7H2zM2 5l6 4.5L14 5',
};
---

<section id="contact" data-od-id="contact" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
    <div data-reveal>
      <h2 class="font-mono text-xs uppercase tracking-widest text-ink-2">$ mail -s "hello"</h2>
    </div>
    <div class="mt-8 grid gap-12 md:grid-cols-[2fr_1fr] md:gap-20">
      <div data-reveal>
        <p class="font-display text-[clamp(2.25rem,6vw,4rem)] leading-[1.05] font-semibold tracking-tight">
          Something on fire, or about to be? <a href={`mailto:${site.email}`} class="underline decoration-2 underline-offset-8 decoration-accent hover:text-accent transition-colors">Write to me.</a>
        </p>
      </div>
      <div data-reveal class="space-y-6 font-mono text-sm self-start">
        <div>
          <p class="text-xs uppercase tracking-widest text-ink-2">email</p>
          <a href={`mailto:${site.email}`} class="mt-1.5 block hover:text-accent transition-colors">{site.email}</a>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-ink-2">pgp</p>
          <p class="mt-1.5 break-all text-ink-2">{site.pgp}</p>
        </div>
        <ul class="flex gap-3 pt-2">
          {
            site.socials.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="flex h-11 w-11 items-center justify-center border border-line bg-paper-2 transition-colors hover:border-ink hover:text-accent"
                >
                  <svg
                    aria-hidden="true"
                    class="h-5 w-5"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={icons[s.icon]} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<footer data-od-id="footer" class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 font-mono text-xs text-ink-2 sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p>© 2026 {site.name} · built with astro</p>
    <p>exit code 0</p>
  </div>
</footer>
