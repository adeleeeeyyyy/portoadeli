{
    "rewrites": [
      {
        "source": "/anonymous",
        "destination": "/pages/anonymous.html"
      },
      {
        "source": "/dashboard",
        "destination": "/pages/dashboard.html"
      }
    ],
    "redirects": [
      {
        "source": "/(.*)",
        "destination": "/page-not-found.html",
        "statusCode": 404
      }
    ]
  }
  