{
    "rewrites": [
      {
        "source": "/anonymous",
        "destination": "/anonymous.html"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      }
    ],
    "redirects": [
      {
        "source": "/*",
        "destination": "/page-not-found.html",
        "statusCode": 404
      }
    ]
  }
  